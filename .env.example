# Copy this file to .env and fill it in. .env is private: it is never committed.

# The live web address (no trailing slash). Needed for the canonical link, sitemap and previews.
SITE_URL=

# Sanity: where the content lives (sanity.io/manage → your project). Empty = use content/defaults.js
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Only for a private dataset: a "Viewer" token so the build can read the content
SANITY_READ_TOKEN=

# Only for `npm run cms:seed`: an "Editor" token. Delete the token in Sanity once seeding is done.
SANITY_WRITE_TOKEN=
